# Copy to apps/api/.env.production on the server. Never commit real secrets.
# Origins, CORS, PORT and trusted proxy are supplied by compose.production.yaml.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy server key fallback; prefer SUPABASE_SECRET_KEY. Never expose in browser.
SUPABASE_SERVICE_ROLE_KEY=
VIPAYMENT_API_ID=
VIPAYMENT_API_KEY=
VIPAYMENT_FULFILLMENT_ENABLED=true
# Keep status polling on when pausing new purchases.
VIPAYMENT_STATUS_POLLING_ENABLED=true
# Optional: dashboard balance for the separate Tripay PPOB/H2H account.
TRIPAY_H2H_API_KEY=
TRIPAY_H2H_MODE=live

TRIPAY_MODE=live
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_BASE_URL=https://tripay.co.id/api
TRIPAY_CALLBACK_URL=https://api.anresstore.site/v1/payments/callback
TRIPAY_RETURN_URL=https://app.anresstore.site/pesanan
PAYMENT_RECONCILIATION_ENABLED=true
ADMIN_USER_IDS=
ADMIN_REQUIRE_MFA=true
# Temporary enrollment only; clear after TOTP setup and before release.
ADMIN_MFA_ENROLLMENT_USER_IDS=
ADMIN_CATALOG_ENABLED=true
# Optional assistant integration.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=

# Admin AI uses separate credentials. Enable after migrating the registry.
ADMIN_AI_ENABLED=false
ADMIN_AI_OPENROUTER_API_KEY=
ADMIN_AI_OPENROUTER_MODEL=openai/gpt-oss-120b
ADMIN_AI_REGISTRY_ENABLED=false
ADMIN_AI_ATTACHMENTS_ENABLED=false
ADMIN_AI_TAVILY_ENABLED=false
TAVILY_API_KEY=
API_OUTBOUND_IPV4_ONLY=false

# Support ticket notifications through Sender.com SMTP.
SUPPORT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Anres Store <support@example.com>
SUPPORT_CS_EMAILS=

# true: pembayaran sandbox dapat mengirim produk ASLI dan memotong saldo VIPayment.
# Memerlukan VIPAYMENT_FULFILLMENT_ENABLED=true. Berlaku juga untuk invoice sandbox lunas yang masih ready.
VIPAYMENT_SANDBOX_FULFILLMENT_ENABLED=false
