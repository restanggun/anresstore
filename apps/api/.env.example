PORT=
CORS_ORIGINS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_WEB_ORIGIN=
AUTH_API_ORIGIN=
AUTH_ADMIN_ORIGIN=

# Kunci OpenRouter hanya disimpan di server API.
OPENROUTER_API_KEY=
# ID model OpenRouter (format provider/model); ubah sesuai model yang tersedia di akun.
# Restart API setelah mengubah .env. Model berbayar dapat dikenakan biaya.
OPENROUTER_MODEL=
# Otomatis dicoba berurutan jika model gagal atau lebih dari 8 detik; maksimal 2 cadangan.
# Periksa tarif setiap model yang dipilih. openrouter/free memilih model gratis yang tersedia.
OPENROUTER_FALLBACK_MODELS=

# Hanya untuk API server; jangan gunakan key ini di browser.
SUPABASE_SECRET_KEY=
# Legacy server key fallback; prefer SUPABASE_SECRET_KEY. Never expose in browser.
SUPABASE_SERVICE_ROLE_KEY=

# VIPayment: hanya untuk server API.
VIPAYMENT_API_ID=
VIPAYMENT_API_KEY=
# Pemenuhan pesanan produksi setelah pembayaran terverifikasi.
VIPAYMENT_FULFILLMENT_ENABLED=true
VIPAYMENT_STATUS_POLLING_ENABLED=true

# Tripay produksi: kredensial merchant hanya disimpan di server API.
# sandbox = uji coba; live = pembayaran sungguhan. Gunakan kredensial sesuai mode.
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
# Kosongkan agar endpoint otomatis mengikuti TRIPAY_MODE.
TRIPAY_BASE_URL=
# Endpoint callback HTTPS pada domain API produksi.
TRIPAY_CALLBACK_URL=
TRIPAY_RETURN_URL=

# Pengamanan pembayaran: hanya isi CIDR/IP reverse proxy yang benar-benar dikelola.
# Kosong berarti X-Forwarded-For tidak dipercaya. Jangan pakai wildcard/0.0.0.0/0.
TRUST_PROXY_CIDRS=
PAYMENT_RECONCILIATION_ENABLED=true
# Opsional untuk whitelist provider dengan alamat egress IPv4 tetap.
API_OUTBOUND_IPV4_ONLY=

# Server-verified Supabase UUIDs allowed to access /v1/admin (comma separated).
ADMIN_USER_IDS=
# MFA admin nonaktif di development lokal; production selalu mewajibkannya.
ADMIN_REQUIRE_MFA=true
# Exact dashboard origins allowed to make admin changes; required in production.
ADMIN_ALLOWED_ORIGINS=
# Temporarily list UUIDs allowed to enroll their first TOTP factor; remove after enrollment.
ADMIN_MFA_ENROLLMENT_USER_IDS=
# Enable only after applying 20261113120000_admin_catalog.sql.
ADMIN_CATALOG_ENABLED=

# Separate sign-in and customer origins (production requires both).
AUTH_AUTH_ORIGIN=
AUTH_APP_ORIGIN=
# Support ticket notifications through Sender.com SMTP.
# Copy the SMTP host, username and password from your Sender.com account.
SUPPORT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Anres Store <support@example.com>
SUPPORT_CS_EMAILS=

# true: pembayaran sandbox dapat mengirim produk ASLI dan memotong saldo VIPayment.
# Memerlukan VIPAYMENT_FULFILLMENT_ENABLED=true. Berlaku juga untuk invoice sandbox lunas yang masih ready.
VIPAYMENT_SANDBOX_FULFILLMENT_ENABLED=false
