PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SUPABASE_URL=https://nyniznlxdavpiiundxcm.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
AUTH_WEB_ORIGIN=http://localhost:3000
AUTH_API_ORIGIN=http://localhost:4000

# Kunci OpenRouter hanya disimpan di server API.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Hanya untuk API server; jangan gunakan key ini di browser.
SUPABASE_SECRET_KEY=

# VIPayment: hanya untuk server API.
VIPAYMENT_API_ID=
VIPAYMENT_API_KEY=

# Tripay: hanya untuk server API. Isi dengan kredensial sandbox saat pengembangan.
# API pembayaran saat ini hanya menerima sandbox; URL produksi akan ditolak.
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
# URL HTTPS tunnel lokal, contoh: https://nama-tunnel.trycloudflare.com/v1/payments/callback
TRIPAY_CALLBACK_URL=
TRIPAY_RETURN_URL=http://localhost:3000

# Pengamanan pembayaran: hanya isi CIDR/IP reverse proxy yang benar-benar dikelola.
# Kosong berarti X-Forwarded-For tidak dipercaya. Jangan pakai wildcard/0.0.0.0/0.
TRUST_PROXY_CIDRS=
PAYMENT_RECONCILIATION_ENABLED=true
# Opsional untuk whitelist provider dengan alamat egress IPv4 tetap.
API_OUTBOUND_IPV4_ONLY=false

# Server-verified Supabase UUIDs allowed to access /v1/admin (comma separated).
ADMIN_USER_IDS=
# Enable only after applying 20261113120000_admin_catalog.sql.
ADMIN_CATALOG_ENABLED=false
